GNANI_API_KEY=your_gnani_api_key_here
LLM_PROVIDER=openrouter           # openrouter | openai | anthropic
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026
TODAY=2026-10-20
EMBED_BACKEND=auto                # auto = BM25 + dense via fastembed; none = BM25 only
TOP_K=8
STT_LANGUAGE=en-IN                # accepts English mixed with Hindi
STT_MODE=itn                      # itn = Gnani inverse text normalisation; boost = word boosting
TTS_MODEL=timbre-v2.5
TTS_VOICE=Kaveri
